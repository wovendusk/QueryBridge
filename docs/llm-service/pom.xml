<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================================
 llm-service/pom.xml — build file for the LLM microservice   (guide step 17)
================================================================================

 WHAT THIS SERVICE IS
   A Spring Boot app that listens on two Kafka topics:
     "description.request"  -> asks the LLM to describe a table's columns
     "sql.generate.request" -> asks the LLM to write (or repair) SQL
   For each request it calls an OpenAI-compatible HTTP API
   (POST {api-url}/chat/completions) and publishes the answer on the matching
   ".response" topic.

 COMPARE WITH query-executor/pom.xml
   Same structure; two differences:
     - spring-boot-starter-WEB instead of plain spring-boot-starter
     - no PostgreSQL driver (this service never touches a database)
================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>   <!-- POM format version -->

    <!-- Inherit from the root POM (Java 21, Spring Boot version table, ...). -->
    <parent>
        <groupId>com.querybridge</groupId>
        <artifactId>querybridge</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>llm-service</artifactId>   <!-- jar: llm-service-1.0-SNAPSHOT.jar -->
    <name>QueryBridge LLM Service</name>
    <description>Kafka-driven LLM microservice for column descriptions and SQL generation</description>

    <dependencies>
        <!-- Shared DTOs (version from the parent's dependencyManagement). -->
        <dependency>
            <groupId>com.querybridge</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!--
          spring-boot-starter-web brings:
            - spring-web: contains RestTemplate, the HTTP CLIENT we use to call
              the OpenAI API. THIS is what the service actually needs.
            - spring-boot-starter-json: Jackson + an auto-configured ObjectMapper
              bean, which LlmService gets injected.
            - Spring MVC + an embedded Tomcat SERVER.
          That last part is the odd one out: this service has no @RestController,
          no HTTP endpoints at all. Yet because Tomcat is on the classpath,
          Spring Boot starts a web server on port 8081 (see application.yml) that
          serves nothing but 404s. It's not harmful, just unnecessary weight.
          A leaner choice would be spring-boot-starter + spring-web (or
          spring-boot-starter-json + spring-web), or simply setting
          spring.main.web-application-type=none like the executor does.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring for Apache Kafka: @KafkaListener, KafkaTemplate, JSON (de)serializers. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build a runnable fat jar (see query-executor/pom.xml for the full explanation). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
